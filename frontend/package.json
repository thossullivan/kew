{
  "name": "kew-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:fixtures": "KEW_UI_FIXTURES=1 vite dev",
    "build": "vite build",
    "build:demo": "KEW_DEMO_BUILD=1 vite build --config demo/vite.demo.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "shoot": "node scripts/shoot.mjs",
    "ui-check": "node scripts/ui-check.mjs",
    "demo-check": "node scripts/demo-check.mjs",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.0.0",
    "jsdom": "^30.1.1",
    "playwright-core": "1.63.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@xyflow/svelte": "^1.7.0",
    "clsx": "^2.1.1",
    "driver.js": "1.9.0",
    "tailwind-merge": "^3.6.0"
  }
}
