# kew.dev — local serving model, mirrored in production.
#
# One tree. `npm run dist` composes the marketing build and the mkdocs output
# into build/, with the docs physically at build/docs/. That is the same
# directory the box serves, so this file and the production site block differ
# only in the address line (":80" here; "kew.dev" there, where Caddy also
# provisions TLS) and in the log block, which is local. The tree is mounted
# at the path production mounts it at, so the root line is the same too.
# tests/site-blocks.test.mjs holds this block to the one in DEPLOY.md.
#
# This previously mounted two trees and stripped the prefix with handle_path.
# It worked, but it meant the thing tested locally was not quite the thing
# served, and the docs' relative asset references resolved by coincidence
# rather than because the paths matched. See DEPLOY.md.

:80 {
	root * /srv/kew
	encode gzip zstd

	# Bare /docs would otherwise 404 — mkdocs expects the trailing slash.
	redir /docs /docs/

	# The docs are a plain static tree and should 404 honestly. Keeping them out
	# of the marketing handler matters: that one falls back to /index.html, which
	# would otherwise answer a mistyped docs URL with the landing page.
	handle /docs/* {
		file_server
	}

	handle {
		try_files {path} {path}/index.html /index.html
		file_server
	}

	header {
		# The site is fully self-contained: no CDN scripts, no remote fonts.
		# The docs serve their own IBM Plex and carry no GitHub widget (#1168);
		# scripts/check-docs.sh fails a build whose pages load another origin.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# A file under /_app/immutable/ is named by its content hash, so a browser
	# may keep it for a year: a rebuild that changes it gives it a new name.
	# The `file` condition is there because the handler above answers a
	# missing path with /index.html, which must never be kept under a
	# script's URL.
	@immutable {
		path /_app/immutable/*
		file
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	log {
		output stdout
		format console
	}
}
#
# demo.kew.dev: the demo console's site block, as a reference. Every line is
# commented out: this file serves kew.dev and nothing else. deploy-demo.sh
# publishes the demo console (frontend/build-demo/) to the deploy host, and
# each publish needs the owner's approval. The block belongs in the host's
# Caddy and DEPLOY.md describes it; the CSP is the one above, unchanged.
#
# A missing file under /_app/ answers 404, never the page shell. /_app/ holds
# only the build's own files, so the /index.html fallback is for page paths.
# With a fallback over every path, a missing /_app/immutable/ chunk answers
# 200 with the shell, and a header matched on the path alone lets a browser
# keep that HTML under a script's URL for a year. deploy-demo.sh uploads with
# rsync --delete, so each publish removes the previous build's chunks, and a
# page loaded before the publish still asks for them. Hence the two
# conditions: @missingAsset keeps /_app/ out of the fallback, and @immutable
# sends the cache header only for a file that exists.
#
# demo.kew.dev {
# 	root * /srv/kew-demo
# 	encode gzip zstd
#
# 	@missingAsset {
# 		path /_app/*
# 		not file {path}
# 	}
# 	handle @missingAsset {
# 		respond 404
# 	}
#
# 	handle {
# 		try_files {path} /index.html
# 		file_server
# 	}
#
# 	header {
# 		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'"
# 		X-Content-Type-Options "nosniff"
# 		Referrer-Policy "strict-origin-when-cross-origin"
# 	}
#
# 	@immutable {
# 		path /_app/immutable/*
# 		file
# 	}
# 	header @immutable Cache-Control "public, max-age=31536000, immutable"
# }
